# VoiceStudio local backend
VOICESTUDIO_URL=http://localhost:3900
# Leave empty to auto-pick the first saved/discovered voice.
VOICESTUDIO_VOICE=
# Optional auth for protected VoiceStudio deployments.
# Example: Authorization / Bearer xxx
VOICESTUDIO_AUTH_HEADER=
VOICESTUDIO_AUTH_VALUE=

# Pexels API: https://www.pexels.com/api/
PEXELS_API_KEY=

# Video
FFMPEG_BIN=ffmpeg
FFPROBE_BIN=ffprobe
OUTPUT_WIDTH=1080
OUTPUT_HEIGHT=1920
FPS=30
BRAND_NAME=拒绝内耗
BRAND_TAGLINE=少一点内耗，保护有限的心力
